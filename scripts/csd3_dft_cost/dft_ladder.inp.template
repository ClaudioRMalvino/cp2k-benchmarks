&GLOBAL
  PROJECT __PROJECT__
  RUN_TYPE MD
  PRINT_LEVEL LOW
  PREFERRED_FFT_LIBRARY FFTW3
  FFTW_PLAN_TYPE MEASURE
  EXTENDED_FFT_LENGTHS T
&END GLOBAL

# On-the-fly (Born-Oppenheimer AIMD) cost ladder for NaCl(aq) at the
# revPBE-D3 level. Every electronic-structure setting below is taken verbatim
# from the deck that generated the O'Neill et al. NaCl(aq) NNP training set
# (potentials/oneill-nacl-water-2024/data-sets/revPBE-D3/revpbe-d3_nacl.inp),
# so this measures the cost of the SAME electronic structure the NNP was
# fitted to - only now evaluated at every MD step instead of once per
# training configuration.
#
# The SYSTEM is the campaign's own NaCl(aq) cell lineage, not a water proxy:
# rungs 1-4 replicate cube_n1 (1 NaCl + 62 H2O, 12.42 A, 0.895 mol/kg, built
# by scripts/cerberus_nacl_diffusion/make_base_cell.py - the same builder that
# produced every campaign cell), and rung 5 is the production cube_n3
# configuration itself (30 NaCl + 1668 H2O, 37.26 A, 1.000 mol/kg). Molality
# is constant across the fitted rungs, so the slope is a clean cost-vs-N
# scaling exponent, and the headline rung is the literal production cell.

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    CHARGE 0
    BASIS_SET_FILE_NAME __DATA__/GTH_BASIS_SETS
    POTENTIAL_FILE_NAME __DATA__/POTENTIAL
    &SCF
      MAX_SCF 20
      EPS_SCF 5.0E-07
      SCF_GUESS ATOMIC
      &OT T
        MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
      &END OT
      &OUTER_SCF T
        EPS_SCF 5.0E-07
        MAX_SCF 20
      &END OUTER_SCF
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &QS
      METHOD GPW
      EXTRAPOLATION USE_GUESS
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-14
    &END QS
    &MGRID
      NGRIDS 5
      CUTOFF 1200
    &END MGRID
    &XC
      DENSITY_CUTOFF 1.0E-10
      GRADIENT_CUTOFF 1.0E-10
      TAU_CUTOFF 1.0E-10
      &XC_GRID
        XC_DERIV SPLINE2_SMOOTH
      &END XC_GRID
      &XC_FUNCTIONAL NO_SHORTCUT
        &PBE T
          PARAMETRIZATION REVPBE
        &END PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          R_CUTOFF 15.0
          TYPE DFTD3
          PARAMETER_FILE_NAME __DATA__/dftd3.dat
          REFERENCE_FUNCTIONAL revPBE
          LONG_RANGE_CORRECTION T
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC [angstrom] __ABC__ __ABC__ __ABC__
      PERIODIC XYZ
      MULTIPLE_UNIT_CELL __NREP__
    &END CELL
    &KIND H
      BASIS_SET TZV2P-GTH-q1
      MASS 2.0
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET TZV2P-GTH-q6
      POTENTIAL GTH-PBE-q6
    &END KIND
    &KIND Na
      BASIS_SET TZV2P-GTH-q9
      POTENTIAL GTH-PBE-q9
    &END KIND
    &KIND Cl
      BASIS_SET TZV2P-GTH-q7
      POTENTIAL GTH-PBE-q7
    &END KIND
    &TOPOLOGY
      MULTIPLE_UNIT_CELL __NREP__
    &END TOPOLOGY
    &COORD
      @INCLUDE __COORD__
    &END COORD
  &END SUBSYS
&END FORCE_EVAL

&MOTION
  &MD
    ENSEMBLE NVE
    STEPS __STEPS__
    TIMESTEP 0.5
    TEMPERATURE 300.0
  &END MD
  &PRINT
    &TRAJECTORY
      &EACH
        MD 100000
      &END EACH
    &END TRAJECTORY
    &RESTART OFF
    &END RESTART
    &RESTART_HISTORY OFF
    &END RESTART_HISTORY
  &END PRINT
&END MOTION
