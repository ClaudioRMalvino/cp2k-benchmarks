# Madrid-2019 NaCl(aq) MSD production: NPT density equilibration -> NVT.
# Force field lives in madrid.settings, shared with in.madrid_vacf.
# Variables (override with -var): data, settings, T, equil_ps, prod_ps, seed, tag
variable data     index data.nacl
variable settings index madrid.settings
variable T        index 298.15
variable equil_ps index 200        # NPT density equilibration
variable prod_ps  index 2000       # NVT production (2 ns default, cheap classical)
variable seed     index 4321
variable tag      index run

units           real               # A, kcal/mol, e, fs
atom_style      full
boundary        p p p

read_data       ${data}
include         ${settings}        # pair/bond/angle styles + coeffs, SHAKE, groups

# --- minimize then equilibrate density at 1 bar (NPT) ---
minimize        1.0e-4 1.0e-6 1000 10000
velocity        all create ${T} ${seed} mom yes rot yes dist gaussian

timestep        2.0
thermo          500
thermo_style    custom step temp press density pe ke etotal

fix             eq all npt temp ${T} ${T} 100.0 iso 1.0 1.0 1000.0
run             $(v_equil_ps*500)          # ps -> 2 fs steps
unfix           eq

# --- NVT production: MSD (diffusion) + velocities (VACF) + per-atom for later ---
reset_timestep  0
# Tdamp = 1 ps, not 100 fs. Nose-Hoover is deterministic and conserves momentum,
# so it does not kill diffusion outright, but tight coupling perturbs the
# short-time velocity correlations that set D. 1 ps is loose enough to leave the
# dynamics alone while still holding T. (The VACF runs go further and use NVE.)
fix             prod all nvt temp ${T} ${T} 1000.0

# mean-squared displacement per species (unwrapped) for Einstein diffusion.
# NOTE: `compute msd` uses a SINGLE time origin (production start), so it yields
# one displacement sample per atom for the whole run. We keep it as a cheap
# cross-check, but the production estimate comes from the unwrapped-coordinate
# dump below, which lets us average the MSD over ~1000 sliding time origins.
compute         msdO  water msd
compute         msdNa na    msd
compute         msdCl cl    msd
fix             fmsd all ave/time 10 1 10 c_msdO[4] c_msdNa[4] c_msdCl[4] &
                file ${tag}.msd mode scalar

# Unwrapped coords every 1 ps for the multi-time-origin MSD. H atoms carry no
# independent diffusion information (SHAKE ties them to O), so dump O + ions
# only: ~3x smaller files.
group           mobile type 1 3 4
dump            pos mobile custom 500 ${tag}.pos.lammpstrj id type xu yu zu
dump_modify     pos sort id format line "%d %d %.4f %.4f %.4f"

thermo          1000
run             $(v_prod_ps*500)
write_data      ${tag}.final.data
print           "DONE ${tag}"
