# Madrid-2019 NaCl(aq) conductivity production: NPT density equil -> NVT with
# position dump (self + collective Onsager MSDs) and Na-Cl RDF (pairing PMF).
# Force field lives in madrid.settings, shared with in.madrid_nacl/in.madrid_vacf.
# Variables (override with -var): data, settings, T, equil_ps, prod_ps, seed, tag
variable data     index data.nacl
variable settings index madrid.settings
variable T        index 298.15
variable equil_ps index 200        # NPT density equilibration
variable prod_ps  index 2000       # NVT production
variable seed     index 4321
variable tag      index run

units           real               # A, kcal/mol, e, fs
atom_style      full
boundary        p p p

read_data       ${data}
include         ${settings}        # pair/bond/angle styles + coeffs, SHAKE, groups

# --- minimize then equilibrate density at 1 bar (NPT) ---
minimize        1.0e-4 1.0e-6 1000 10000
velocity        all create ${T} ${seed} mom yes rot yes dist gaussian

timestep        2.0
thermo          500
thermo_style    custom step temp press density pe ke etotal

fix             eq all npt temp ${T} ${T} 100.0 iso 1.0 1.0 1000.0
run             $(v_equil_ps*500)          # ps -> 2 fs steps
unfix           eq

# --- NVT production ---
reset_timestep  0
fix             prod all nvt temp ${T} ${T} 1000.0   # loose Tdamp = 1 ps

# Unwrapped coords every 1 ps: self MSDs AND collective ion displacements
# (Onsager L_ij / Einstein-Helfand conductivity) both come from this one dump.
group           mobile type 1 3 4
dump            pos mobile custom 500 ${tag}.pos.lammpstrj id type xu yu zu
dump_modify     pos sort id format line "%d %d %.4f %.4f %.4f"

# Na-Cl RDF averaged over the whole production run -> w(r) = -kT ln g(r),
# the pairing PMF to overlay on the O'Neill MP2/RPA benchmark (their Fig 3).
compute         rdfNaCl all rdf 200 3 4
fix             frdf all ave/time 100 $(v_prod_ps*5) $(v_prod_ps*500) &
                c_rdfNaCl[*] file ${tag}.rdf mode vector

thermo          1000
run             $(v_prod_ps*500)
write_data      ${tag}.final.data
print           "DONE ${tag}"
